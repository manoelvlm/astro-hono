{
  "compatibility_date": "2026-01-24",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "web",
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "API",
      "service": "api",
    },
  ],
}
