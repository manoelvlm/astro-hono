{
  "name": "astro-hono-monorepo",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter @repo/api dev",
    "dev:web": "bun --filter @repo/web dev",
    "types:api": "bun --filter @repo/api cf-typegen",
    "deploy:api": "bun --filter @repo/api deploy",
    "deploy:web": "bun --filter @repo/web deploy",
    "deploy:all": "bun --filter \"*\" deploy",
    "db:migrate:local": "bun --filter @repo/api migrate:local",
    "db:generate": "bun --filter @repo/api generate",
    "db:migrate:remote": "bun --filter @repo/api migrate:remote",
    "db:studio": "bun --filter @repo/api studio"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260124.0",
    "@types/bun": "^1.3.6"
  },
  "devDependencies": {
    "@repo/api": "workspace:*",
    "@repo/web": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "wrangler": "^4.60.0"
  }
}
