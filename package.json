{
  "name": "astro-hono-monorepo",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "deploy:api": "bun --filter api deploy",
    "deploy:web": "bun --filter web deploy",
    "deploy:all": "bun --filter \"*\" deploy",
    "db:migrate:local": "bun --filter api migrate:local",
    "db:migrate:remote": "bun --filter api migrate:remote",
    "db:studio": "bun --filter api studio"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260124.0",
    "@types/bun": "^1.3.6"
  },
  "devDependencies": {
    "api": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "wrangler": "^4.60.0"
  }
}
